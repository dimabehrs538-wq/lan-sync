{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeamSync",
  "version": "0.1.0",
  "identifier": "com.teamsync.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "团队同步", "width": 980, "height": 680, "minWidth": 760, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/teamsyncd", "binaries/syncthing"],
    "resources": { "binaries/SYNCTHING-LICENSE.txt": "SYNCTHING-LICENSE.txt" },
    "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false } }
  }
}
